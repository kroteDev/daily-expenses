# Copy to /var/www/projects/daily-expenses/.env on the droplet and fill in real values.
# This file is read by docker-compose.prod.yml. Never commit the real one.

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_INTERNAL_PORT=5432
DATABASE_NAME=daily_expenses
DATABASE_USER=daily_expenses
DATABASE_PASSWORD=change_me_in_production

# Contents of api/config/master.key (decrypts config/credentials.yml.enc)
RAILS_MASTER_KEY=

# Host ports, proxied by Nginx (see nginx/daily-expenses.conf)
API_PORT=5000
WEB_PORT=5001

# Public URLs
NEXT_PUBLIC_API_URL=https://api.expenses.krotedev.com.br
ALLOWED_HOSTS=api.expenses.krotedev.com.br
CORS_ORIGINS=https://expenses.krotedev.com.br
